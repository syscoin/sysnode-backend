{
  "name": "sysnode",
  "version": "1.0.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "description": "Syscoin backend for masternode and governance stats",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "privacy:start": "node --env-file-if-exists=.env privacy-server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:sentry-codec": "node --test tests/sentry-codec.integration.mjs tests/syscoin-dependencies.integration.mjs",
    "test:sentry-core": "node scripts/sentry-core-regtest.mjs",
    "test:recovery-anvil": "node --test tests/recovery-anvil.integration.mjs",
    "verify:sentry-deployment": "node scripts/verify-sentry-deployment.js",
    "test:coverage": "jest --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "routes/**/*.js",
      "middleware/**/*.js",
      "!**/node_modules/**"
    ]
  },
  "dependencies": {
    "@sidhujag/sysweb3-sentry": "0.1.1",
    "@syscoin/syscoin-js": "git+https://github.com/syscoin/syscoind-rpc.git#637a1de10522d1ce34a4e0f283c59b9d55bde814",
    "axios": "^1.15.2",
    "better-sqlite3": "^12.9.0",
    "body-parser": "2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "csv-parser": "3.0.0",
    "ethers": "6.17.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "fs": "0.0.1-security",
    "geoip-country": "^5.0.202605052357",
    "helmet": "^8.1.0",
    "i18n-iso-countries": "7.5.0",
    "moment": "^2.30.1",
    "nodemailer": "^10.1.2",
    "numeral": "2.0.6",
    "papaparse": "^5.5.3",
    "pretty-ms": "6.0.1",
    "syscoinjs-lib": "^1.0.275",
    "websocket": "1.0.34",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "syscoin",
    "masternode",
    "governance",
    "express",
    "backend"
  ],
  "author": "Your Name",
  "license": "MIT",
  "overrides": {
    "node-fetch": "2.7.0",
    "elliptic": "6.6.1",
    "ip-address": "10.7.4",
    "ws": "8.21.3"
  }
}
